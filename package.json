{
  "name": "povrayer-root",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:node && npm run test:browser",
    "pretest:node": "node tools/link-wrapper.mjs",
    "test:node": "node --test \"test/node/*.test.mjs\"",
    "test:browser": "node test/browser/browser.test.mjs; b=$?; node test/browser/ui.test.mjs; u=$?; node test/browser/repl.test.mjs; r=$?; exit $((b||u||r))",
    "test:unit": "node --test \"test/node/*.unit.test.mjs\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p wrapper/tsconfig.json",
    "coverage": "node tools/coverage/run.mjs",
    "coverage:check": "node tools/coverage/check.mjs",
    "prepare": "node tools/install-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "c8": "11.0.0",
    "eslint": "10.4.1",
    "globals": "17.6.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "playwright": "1.60.0",
    "prettier": "3.8.3",
    "typescript": "5.8.3",
    "v8-to-istanbul": "9.3.0"
  }
}
