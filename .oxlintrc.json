{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "rules": {
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": ["web/**/*.{js,ts}"],
      "env": {
        "browser": true,
        "node": false
      }
    },
    {
      "files": ["test/browser/**/*.mjs"],
      "env": {
        "browser": true,
        "node": true
      }
    }
  ],
  "ignorePatterns": [
    "dist/**",
    "_site/**",
    "_build/**",
    ".claude/worktrees/**",
    ".vercel/**",
    "node_modules/**",
    "coverage/**",
    ".playwright-cli/**",
    "web/coi-serviceworker.js",
    "src/index.js"
  ]
}
