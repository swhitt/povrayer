{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/assemble-site.mjs",
  "outputDirectory": "_site",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    { "source": "/x/:id", "destination": "/?x=:id", "permanent": false },
    { "source": "/e/:name", "destination": "/?example=:name", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
