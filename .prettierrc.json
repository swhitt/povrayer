{
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "always",
  "overrides": [
    {
      "files": "wrapper/**/*.ts",
      "options": {
        "tabWidth": 4,
        "singleQuote": false,
        "trailingComma": "all"
      }
    }
  ]
}
