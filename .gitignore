dist/
node_modules/
*.log
.DS_Store

# Merged coverage reports (node + browser). Root-anchored so it never swallows
# tools/coverage/ (the committed harness scripts). The .nyc_output/ + *.lcov
# patterns catch c8/istanbul defaults if a tool ever writes outside coverage/.
/coverage/
.nyc_output/
*.lcov

# CLI testability shim: gitignored symlink to dist/index.js created by
# tools/link-wrapper.mjs so src/cli.mjs can resolve its `./index.js` import.
src/index.js

# playwright-cli scratch output (snapshots, console logs)
.playwright-cli/

# Test output (rendered PNGs from CLI/docker runs against the fixtures)
test/fixtures/*.png
test-output/

# Assembled Vercel static output (dist/ + web/, built by tools/assemble-site.mjs)
/_site/

# Compiled web/ TypeScript (tools/build-web.mjs -> tsconfig.build.json). Wiped and
# regenerated on every serve/assemble/test run, so it is pure derived output.
/_build/

# Vercel CLI local state + prebuilt output
.vercel/
.vercel

# sdf-toy sweep data, regenerated from web/examples.js by the harness
experiments/sdf-toy/gallery-sweep.json

# local-only experiment briefs & research notes (kept out of history on purpose)
experiments/sdf-toy/FABLE-PROMPT.md
research/
