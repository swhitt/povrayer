{
  // The strict tier. tsconfig.checkjs.json checks every first-party JS module at
  // DEFAULT checkJs strictness (see the long rationale there): good enough to
  // catch wrong argument types and bad call signatures, deliberately quiet about
  // "possibly null" across DOM-heavy UI code.
  //
  // That leaves real bugs reachable. web/turbo-sw.js shipped a
  // `.catch(() => caches.match(...))` whose miss path resolves to `undefined`,
  // handing `respondWith(undefined)` to the service worker spec. Prettier,
  // eslint, checkJs, and a 100% four-metric coverage gate all pass on it; there
  // is no conditional, so no branch for the gate to miss. `strictNullChecks`
  // catches it on one line.
  //
  // So this config runs FULL strict over web/'s TypeScript, and CI enforces it.
  // Every module written in TypeScript is listed here (test/node/coverage-config.test.mjs
  // asserts exactly that, in both directions), which is what makes "rename to .ts"
  // mean "opt into strict" rather than "quietly turn 254 @param into any".
  //
  // Graduating a file still means fixing its whole import closure, not just the
  // file: render-orchestrator.ts also buys live-draft.ts. Check with
  // `npx tsc -p tsconfig.strict.json --listFiles`.
  "extends": "./tsconfig.checkjs.json",

  "compilerOptions": {
    "strict": true,

    // TypeScript only. The JavaScript that is still in web/ stays in the program
    // (the .ts modules import it, and its JSDoc types are still read for
    // inference), it just does not have ITS OWN errors reported here.
    //
    // Not a shrug: it is forced, and the forcing is worth writing down. Four
    // modules -- highlight.js, context.js, complete.js, glsl-highlight.js -- are
    // inlined VERBATIM into web/turbo.html by tools/gen-turbo.mjs, and
    // test/node/turbo-lang.test.mjs pins that generated file byte-for-byte. So
    // they cannot take a single character of annotation (not even a JSDoc
    // comment) without regenerating turbo.html, which must keep working from
    // file:// with no server. Any module that imports them (web/ui.js and
    // web/repl.js do) would drag them into a strict tier that checked .js, so
    // that tier could never admit those two at all.
    //
    // The .js side is not unchecked: tsconfig.checkjs.json covers every one of
    // those modules at default checkJs strictness, which is where JavaScript in
    // this repo has always been held. The split is now clean and mechanical:
    // .ts is checked here at full strict, .js is checked there.
    "checkJs": false
  },

  // Alphabetical, and every entry is a .ts module. Each is also enrolled in
  // tools/coverage/paths.mjs FIRST_PARTY, asserted by
  // test/node/coverage-config.test.mjs so this list cannot drift away from the
  // coverage manifest, and a .js path here would be a silent no-op under
  // checkJs:false, so that is asserted against too.
  "include": [
    "web/anim-export.ts",
    "web/apng.ts",
    "web/asset-drop.ts",
    "web/assets.ts",
    "web/coi.ts",
    "web/dom.ts",
    "web/example-filters.ts",
    "web/flags.ts",
    "web/gallery.ts",
    "web/gif.ts",
    "web/history.ts",
    "web/live-draft.ts",
    "web/orb.ts",
    "web/permalink.ts",
    "web/player.ts",
    "web/render-client.ts",
    "web/render-feedback.ts",
    "web/render-orchestrator.ts",
    "web/repl-scene.ts",
    "web/scene-state.ts",
    "web/sdl-strip.ts",
    "web/sdl-validate.ts",
    "web/settings.ts",
    "web/sliders.ts",
    "web/stats.ts",
    "web/url-params.ts"
  ]
}
