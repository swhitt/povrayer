#!/bin/sh
# Fast pre-commit gate: format, lint, wrapper types, and the fast unit subset.
# POSIX sh, fail on the first problem with a clear message. The heavy stuff
# (full render suite + 100% coverage) runs in pre-push, not here.
set -e

say() { printf '\npre-commit: %s\n' "$1"; }

say 'prettier --check'
npx prettier --check .

say 'eslint'
npx eslint .

say 'tsc --noEmit (wrapper)'
npx tsc --noEmit -p wrapper/tsconfig.json

# Pure-logic Node tests only. The wasm render tests are slow and belong in CI.
say 'fast node unit tests'
npm run test:unit

say 'ok'
