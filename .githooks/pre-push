#!/bin/sh
# Pre-push gate: the fast static checks only (format, lint, wrapper types). The
# full render suite + 100% coverage gate live in CI (ci.yml), which is the
# authoritative last word; duplicating them here made every push take minutes.
# These three catch the common mistakes (formatting, lint, type errors) in a
# couple of seconds, before code reaches CI.
set -e

say() { printf '\npre-push: %s\n' "$1"; }

say 'prettier --check'
npm run format:check

say 'eslint'
npm run lint

say 'tsc --noEmit (wrapper)'
npm run typecheck

say 'ok'
