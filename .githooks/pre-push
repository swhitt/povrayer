#!/bin/sh
# Pre-push gate: format, lint, wrapper types, the full render suite, and the
# 100% coverage check. Slow but authoritative, the last line before code leaves
# the machine. Mirrors CI's lint job (format + eslint + tsc) so a push whose
# pre-commit was bypassed (--no-verify, an amend/rebase, a hook-skipping GUI)
# can't slip a formatting or type error through to CI.
#
# `npm run coverage` runs the ENTIRE suite (node + browser) under c8, so it
# doubles as the full `npm test` run; coverage:check then enforces 100%.
set -e

say() { printf '\npre-push: %s\n' "$1"; }

say 'prettier --check'
npm run format:check

say 'eslint'
npm run lint

say 'tsc --noEmit (wrapper)'
npm run typecheck

# checkJs over the first-party plain JS (JSDoc types). Lives here, not in
# pre-commit, because it resolves the built wrapper's types from dist/ (the
# .d.ts shims + test imports), which pre-commit doesn't guarantee but this gate
# does (the coverage run below needs dist too). Mirrors CI's build-test job.
say 'tsc --noEmit (first-party JS, checkJs)'
npm run typecheck:js

say 'full suite + merged coverage (node + browser)'
npm run coverage

say 'coverage gate (100% first-party)'
npm run coverage:check

say 'ok'
